{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py", "stop"],
            "async": true,
            "timeout": 90,
            "statusMessage": "Speaking..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(robot-voice:)?speak$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py", "command"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
