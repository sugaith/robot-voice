{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude.py",
              "stop"
            ],
            "async": true,
            "timeout": 90,
            "statusMessage": "Speaking..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^robot-voice:(use|voice|all|tldr|brief|vol|help)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude.py",
              "command"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude.py",
              "ask"
            ],
            "async": true,
            "timeout": 90
          }
        ]
      }
    ]
  }
}
